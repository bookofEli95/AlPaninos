{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "pnpm": "12.3.4"
    },
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "extends": "base",
      "environment": "development"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "extends": "base",
      "environment": "preview"
    },
    "production": {
      "autoIncrement": true,
      "extends": "base",
      "environment": "production"
    }
  },
  "submit": {
    "production": {}
  }
}
